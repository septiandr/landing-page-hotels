# ===== Database (PostgreSQL) =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hotel_landing?schema=public"

# ===== Auth (CMS admin) =====
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="change-me"
# Secret untuk melindungi endpoint cron (Vercel Cron → /api/cron/publish)
CRON_SECRET="change-me-2"

# ===== Storage upload (CMS-B-008) =====
# local (default) | s3 (perlu implementasi StorageProvider)
STORAGE_DRIVER="local"

# ===== Public / Client =====
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== Booking Engine (Cloudbeds — lihat doc/06) =====
# mock (dev/test) | cloudbeds (production)
BOOKING_ENGINE_PROVIDER="mock"
CLOUDBEDS_API_KEY=""
CLOUDBEDS_PROPERTY_ID=""
CLOUDBEDS_API_BASE_URL="https://hotels.cloudbeds.com/api/v1.0"
# Kode 6-char properti dari Cloudbeds PMS → Settings → Booking Engine
NEXT_PUBLIC_CLOUDBEDS_PROPERTY_CODE=""

# ===== Analytics (optional, kosongkan jika belum dipakai) =====
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
# GA4 Measurement Protocol (server-side booking_completed, BK-009)
GA4_MP_API_SECRET=""
GA4_MP_MEASUREMENT_ID=""

# ===== WhatsApp (format: 62xxxxxxxxxx, tanpa +) =====
NEXT_PUBLIC_WHATSAPP_NUMBER=""
